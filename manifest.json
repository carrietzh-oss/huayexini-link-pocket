{
  "manifest_version": 3,
  "name": "花野链接夹",
  "version": "0.3.5",
  "description": "在 X、Instagram 和 YouTube 一键保存单条内容，自动分类并保留封面与内容说明。",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "保存到花野链接夹",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ]
}
